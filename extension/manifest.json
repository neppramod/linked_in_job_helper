{
  "manifest_version": 3,
  "name": "LinkedIn Job Helper",
  "version": "1.0.0",
  "description": "Save LinkedIn jobs to a tracker and CSV, write cover letters, hide jobs you do not want, and see how well each job fits.",
  "permissions": [
    "activeTab",
    "scripting",
    "clipboardWrite",
    "downloads",
    "storage"
  ],
  "host_permissions": [
    "https://www.linkedin.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.linkedin.com/*"
      ],
      "js": [
        "settings-store.js",
        "filter.js",
        "fit.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html",
  "action": {
    "default_popup": "popup.html",
    "default_title": "LinkedIn Job Helper",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+L"
      },
      "description": "Open Job Helper"
    },
    "remove-job": {
      "suggested_key": {
        "default": "Alt+Shift+R"
      },
      "description": "Remove current job from tracker"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}